generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int               @id @default(autoincrement())
  key       String            @unique
  name      String
  order     Int               @default(0)
  items     QuoteItem[]
  templates SubItemTemplate[]
  lineItems LineItem[]
}

// 대공정별 기본 세부항목 (예: 목공 → 방문 교체, 몰딩)
model SubItemTemplate {
  id         Int      @id @default(autoincrement())
  categoryId Int
  name       String
  order      Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// 업체 견적의 실제 금액 줄 — 기본 세부항목 이름이거나 커스텀 이름
model LineItem {
  id         Int      @id @default(autoincrement())
  vendorId   Int
  categoryId Int
  name       String
  amount     Int      @default(0)
  memo       String?
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Vendor {
  id          Int         @id @default(autoincrement())
  name        String
  contact     String?
  memo        String?
  vatIncluded Boolean     @default(true)
  createdAt   DateTime    @default(now())
  items       QuoteItem[]
  lineItems   LineItem[]
}

// 공정(대공정) 단위 상태. 금액은 LineItem에 있고, 세부항목이 하나라도 있으면 '포함'으로 본다.
// EXCLUDED  = 미포함 (추가금 위험)
// BUNDLED   = 다른 공정에 묶여 있음 (금액 중복 계산 금지)
// UNKNOWN   = 확인 필요 (기본)
model QuoteItem {
  id         Int      @id @default(autoincrement())
  vendorId   Int
  categoryId Int
  status     String   @default("UNKNOWN")
  memo       String?
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([vendorId, categoryId])
}
